# Everything here is optional. Without tokens the service has no login, which
# suits a personal machine. Run npm run setup (or awaker setup) to fill in two
# distinct random tokens and require a sign-in.
# AWAKER_ADMIN_TOKEN=
# AWAKER_AGENT_TOKEN=
AWAKER_HOST=127.0.0.1
PORT=4173
AWAKER_PUBLIC_URL=http://127.0.0.1:4173
AWAKER_API_URL=http://127.0.0.1:4173
# Optional custom database location. Existing data/sunday.sqlite is reused automatically.
# AWAKER_DB=/absolute/path/to/awaker.sqlite
# Required for the background service: the Sleeper account it reports on. It is
# fixed at startup and cannot be changed through the browser.
SLEEPER_USERNAME=
# Optional. Phone notifications are normally set up in the browser. These are defaults
# until then: only NTFY_TOPIC is required, NTFY_URL defaults to https://ntfy.sh, and
# NTFY_TOKEN is only for access-controlled topics.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
