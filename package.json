{
  "name": "awaker",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.js",
    "test": "node --test tests/*.test.js",
    "service": "node --env-file-if-exists=.env server/main.js",
    "mcp": "node --env-file-if-exists=.env server/mcp.js",
    "setup": "node scripts/setup.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "A self-hosted, read-only companion for your Sleeper fantasy football leagues.",
  "repository": {
    "type": "git",
    "url": "https://github.com/afk-sapien/awaker.git"
  },
  "license": "MIT"
}
